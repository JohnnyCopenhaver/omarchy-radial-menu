{
  "schemaVersion": 1,
  "id": "john-copenhaver.radial-menu",
  "name": "Radial Menu",
  "version": "1.0.0",
  "author": "John Copenhaver",
  "license": "MIT",
  "description": "A radial (pie) replacement for the Omarchy menu, with category rings for apps and installers, pins, and recents",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "menu": "Menu.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Radial Menu",
    "description": "Opens the radial Omarchy menu",
    "category": "Compositor",
    "allowMultiple": false
  },
  "omarchy": {
    "clonedFrom": "omarchy.menu"
  }
}
